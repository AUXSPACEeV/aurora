/ {
	chosen {
		/* Auxspace specific */
		auxspace,baro = &bmp581_0;
		auxspace,rbf = &button1;
		auxspace,vbat = &vbatt;
		auxspace,disk-led = &sd_activity_led;
		auxspace,telemetry-hc12 = &hc12;
	};

	hc12: hc12 {
		compatible = "auxspaceev,hc12";
		uart = <&uart0>;
		status = "okay";
	};
};

&bmp581_0 {
	status = "okay";
	odr = <BMP581_DT_ODR_100_2_HZ>;
};

&vbatt {
	status = "okay";
};

&sdhc {
	status = "okay";
};

&sdhc0 {
	status = "okay";
};
