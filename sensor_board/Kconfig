# This file is the application Kconfig entry point. All application Kconfig
# options can be defined here or included via other application Kconfig files.
# You can browse these options using the west targets menuconfig (terminal) or
# guiconfig (GUI).

menu "Zephyr"

source "Kconfig.zephyr"

endmenu

module = SENSOR_BOARD
module-str = SENSOR_BOARD
source "subsys/logging/Kconfig.template.log_config"

# The simulated sample sources themselves live with the sensors they stand
# in for; see AURORA_FAKE_SENSORS in aurora/lib/sensor/Kconfig.

config AURORA_SIM_AUTOTEST
	bool "Automated simulation test (CI mode)"
	depends on IMU && BARO
	depends on AURORA_STATE_MACHINE && SHELL
	select AURORA_FAKE_SENSORS
	select ASSERT
	help
	  Enables the full automated flight simulation for CI. Pulls in the
	  simulated sensors and assertion support, then has the state machine
	  thread launch the flight as soon as attitude calibration completes.
	  Exits with code 0 on SM_LANDED, code 1 on SM_ERROR or after
	  AURORA_SIM_AUTOLAUNCH_TIMEOUT_MS. Run ./zephyr.exe and check the
	  process exit code.

config AURORA_SIM_AUTOLAUNCH_TIMEOUT_MS
	int "Autolaunch watchdog timeout (ms)"
	depends on AURORA_SIM_AUTOTEST
	default 120000
	help
	  Maximum time in milliseconds to wait for SM_LANDED after launching
	  the flight. Exits with code 1 if this deadline is exceeded.

config SENSOR_BOARD_STATUS_INTERVAL_MS
	int "Telemetry status heartbeat interval (ms)"
	depends on AURORA_TELEMETRY && AURORA_STATE_MACHINE
	default 1000
	range 0 60000
	help
	  Period of the STATUS telemetry frame sent while the vehicle is
	  not in flight (pad, error hold, landed). It carries the flight
	  state and sensor/calibration/log health, and unlike SM updates
	  it does not wait for both sensors to report - so the ground
	  station hears from a board whose IMU or barometer is down.
	  Suppressed in flight, where it would compete with SM updates
	  for airtime. 0 disables it.
