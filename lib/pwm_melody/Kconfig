config AURORA_PWM_MELODY
	bool "API for playing music on a buzzer"
	depends on BUZZER
	help
	  Enable the melody API. Melodies are played through Zephyr's
	  generic buzzer API, e.g. on a "pwm-buzzer" devicetree node.

if AURORA_PWM_MELODY

module = AURORA_PWM_MELODY
module-str = AURORA_PWM_MELODY
source "subsys/logging/Kconfig.template.log_config"

endif # AURORA_PWM_MELODY
