module = AURORA_SENSORS
module-str = AURORA_SENSORS
source "subsys/logging/Kconfig.template.log_config"

config AURORA_SENSORS
	bool "Support for sensor HAL"
	default y if SENSOR
	help
		This option enables functionality for the aurora sensor HAL.

config AURORA_FAKE_SENSORS
	bool "Simulated IMU/baro sample source (no hardware)"
	depends on AURORA_SENSORS
	depends on AURORA_STATE_MACHINE
	depends on SHELL
	help
	  Replace the hardware sample source in imu.c and baro.c with a
	  synthetic flight profile. Only the source changes: the sensors are
	  read on the same schedule and publish on the same zbus channels, so
	  the whole data path, attitude tracker, filter and state machine can
	  be exercised without real sensors. IMU_FREQUENCY and BARO_FREQUENCY
	  set the rate as usual. Works on native_sim and on real hardware --
	  use the `sim` snippet (`west build -S sim ...`) to layer it on top
	  of any board. The `sim launch` shell command starts the flight.

config AURORA_FAKE_SENSORS_REPLAY
	bool "Replay a recorded flight instead of the synthetic profile"
	depends on IMU && BARO
	select AURORA_FAKE_SENSORS
	help
	  Swap the synthetic profile for playback of a real flight, embedded
	  at build time from a recorded flights.csv. Pre-launch it holds the
	  first recorded sample so attitude calibration converges as usual;
	  `sim launch` then plays the recording back against its original
	  timeline, each read returning the newest sample whose timestamp has
	  passed. Implies AURORA_FAKE_SENSORS.

config AURORA_FAKE_SENSORS_SYNTH
	def_bool AURORA_FAKE_SENSORS && !AURORA_FAKE_SENSORS_REPLAY
	help
	  Internal switch: true when the simulated source should be the
	  synthetic flight profile rather than a recorded flight.

config AURORA_FAKE_SENSORS_REPLAY_INPUT
	string "Path to flights.csv used by the replay source"
	depends on AURORA_FAKE_SENSORS_REPLAY
	default "flight_logs/multimeter/2026-05-03/flight1/flights.csv"
	help
	  Path (relative to the aurora module root, i.e. the directory that
	  contains zephyr/module.yml) to the flights.csv file embedded by the
	  replay generator. May be overridden in prj.conf or via
	  -DCONFIG_AURORA_FAKE_SENSORS_REPLAY_INPUT=... to swap recordings.

menu "Inertial Measurement Unit (IMU)"

config IMU
	bool "Support for IMU"
	depends on AURORA_SENSORS
	default y if LSM6DSO
	help
		This option enables functionality for the Inertial Measurement
		Unit (IMU).

config IMU_TRIGGER
	bool "Support for IMU Trigger"
	depends on IMU
	default y if LSM6DSO_TRIGGER
	help
		This option enables functionality for the IMU
		to run triggers in an interrupt context.

# Only show frequency options when IMU is enabled
config IMU_FREQUENCY
	int "IMU update frequency (Hz)"
	depends on IMU
	default 100
	range 1 1000

choice IMU_UP_AXIS
	prompt "IMU body axis pointing up the rocket's long axis"
	depends on IMU || ATTITUDE
	default IMU_UP_AXIS_POS_Z
	help
	  Selects which IMU body-frame axis points toward the rocket's nose
	  when the rocket is vertical on the launch pad. Used to seed the
	  gravity vector for body-to-world projection of accelerometer data.

config IMU_UP_AXIS_POS_X
	bool "+X"
config IMU_UP_AXIS_NEG_X
	bool "-X"
config IMU_UP_AXIS_POS_Y
	bool "+Y"
config IMU_UP_AXIS_NEG_Y
	bool "-Y"
config IMU_UP_AXIS_POS_Z
	bool "+Z"
config IMU_UP_AXIS_NEG_Z
	bool "-Z"

endchoice

config IMU_UP_AXIS_INDEX
	int
	depends on IMU || ATTITUDE
	default 0 if IMU_UP_AXIS_POS_X || IMU_UP_AXIS_NEG_X
	default 1 if IMU_UP_AXIS_POS_Y || IMU_UP_AXIS_NEG_Y
	default 2 if IMU_UP_AXIS_POS_Z || IMU_UP_AXIS_NEG_Z

config IMU_UP_AXIS_SIGN
	int
	depends on IMU || ATTITUDE
	default 1  if IMU_UP_AXIS_POS_X || IMU_UP_AXIS_POS_Y || IMU_UP_AXIS_POS_Z
	default -1 if IMU_UP_AXIS_NEG_X || IMU_UP_AXIS_NEG_Y || IMU_UP_AXIS_NEG_Z

config IMU_CALIBRATION_SAMPLES
	int "IMU calibration samples"
	depends on IMU || ATTITUDE
	default 200
	range 10 10000
	help
	  Minimum number of IMU samples to average while the rocket is
	  stationary in SM_IDLE for accelerometer/gyroscope bias
	  estimation and gravity magnitude measurement, before the running
	  estimate is even checked for convergence. Calibration finishes
	  early once the estimate stops improving, or once a fixed multiple
	  of this many samples have been collected, whichever comes first
	  (see attitude_calibrate_converged()). At IMU_FREQUENCY Hz, this
	  floor is roughly IMU_CALIBRATION_SAMPLES / IMU_FREQUENCY seconds.

config IMU_CALIBRATION_RESTART_DEVIATION_DEG
	int "IMU calibration motion-restart threshold (deg)"
	depends on IMU || ATTITUDE
	default 5
	range 1 90
	help
	  Motion-sensitivity threshold for restarting an in-progress
	  calibration window, used three ways:
	    - Gyroscope: instantaneous magnitude threshold in degrees/second.
	    - Accelerometer: tilt-deviation threshold in degrees, measured
	      from the accelerometer direction recorded at the start of the
	      current window.
	    - Accelerometer: absolute tilt-deviation threshold in degrees,
	      measured from the configured mounting axis (CONFIG_IMU_UP_AXIS_*)
	      rather than the window's own start -- catches an attempt that
	      never held the correct orientation in the first place.
	  Exceeding any threshold while stationary in SM_IDLE discards the
	  in-progress calibration accumulator and restarts the window from
	  the next sample, so a bump or re-aim mid-window doesn't silently
	  corrupt the bias estimate. Tuned to tolerate ordinary pad sway/wind
	  without false-triggering while still catching a genuine bump.

config ATTITUDE
	bool "Attitude tracker (body-frame gravity vector)"
	default y if IMU
	help
	  Builds the gyro-integrated body-frame gravity tracker used to
	  project accelerometer readings onto world vertical.  Requires
	  CONFIG_IMU_UP_AXIS_* to be set.

endmenu

menu "Barometric Pressure Sensor (BARO)"

config BARO
	bool "Support for Baro"
	depends on AURORA_SENSORS
	default y if MS5607 || LPS22HH || BMP581
	help
		This option enables functionality for barometric pressure
		sensors.

config BARO_TRIGGER
	bool "Support for Baro Trigger"
	depends on BARO
	default y if LPS22HH_TRIGGER
	help
		This option enables functionality for barometric pressure
		sensors to run triggers in an interrupt context.

# Only show frequency options when BARO is enabled
config BARO_FREQUENCY
	int "BARO update frequency (Hz)"
	depends on BARO
	default 100
	range 1 1000

endmenu
