config AURORA_STATE_MACHINE
	bool "Support for state machine"
	help
		This option enables functionality for the aurora state machine
		lib.

if AURORA_STATE_MACHINE

module = STATE_MACHINE
module-str = STATE_MACHINE
source "subsys/logging/Kconfig.template.log_config"

choice AURORA_STATE_MACHINE_TYPE
	bool "State Machine Type"
	depends on AURORA_STATE_MACHINE
	default SIMPLE_STATE

config SIMPLE_STATE
	bool "Simple State machine"
	help
		Simple State machine with apogee detection, single pyro ignition
		and basic safety features.
		Ideal for small form factor boards and rockets.

endchoice

config AURORA_STATE_MACHINE_RBF
	bool "Remove-before-flight arm input"
	depends on GPIO
	help
	  Take the arm signal from the mechanical safety interlock -
	  streamer, key or shorting plug - on the GPIO selected by the
	  auxspace,rbf dt chosen node, instead of from the application.
	  The line is asserted while the interlock is installed (safe); the
	  vehicle counts as armed once it is pulled.  When enabled, the pin
	  overrides sm_inputs.armed on every update.

config AURORA_STATE_MACHINE_RBF_DEBOUNCE_MS
	int "RBF input debounce window (ms)"
	default 50
	range 0 5000
	depends on AURORA_STATE_MACHINE_RBF
	help
	  Time the RBF contact has to stay quiet before a change is taken as
	  real.  Every edge restarts the window, so a chattering plug cannot
	  arm and disarm the machine repeatedly.

config AURORA_STATE_MACHINE_AUDIT
	bool "State machine audit log"
	default y if AURORA_STATE_MACHINE && CONFIG_FILE_SYSTEM
	help
	  Enable a ring-buffer audit log that records timestamped state
	  transitions and notable events.  Useful for post-flight analysis
	  and shell diagnostics.

config AURORA_STATE_MACHINE_AUDIT_LOG_SIZE
	int "Maximum number of audit log entries"
	default 32
	depends on AURORA_STATE_MACHINE_AUDIT
	help
	  Size of the ring buffer used for the audit log.  Oldest entries
	  are silently overwritten when full.

config AURORA_STATE_MACHINE_AUDIT_BASE_PATH
	string "Output directory for state machine audit files"
	default "/state"
	depends on AURORA_STATE_MACHINE_AUDIT
	help
	  Directory where the state machine audit writes output files.
	  The final path is <base_path>/audit.<index>.

config AURORA_STATE_MACHINE_AUDIT_MAX_FILES
	int "Maximum number of files in AURORA_STATE_MACHINE_AUDIT_BASE_PATH"
	default 200
	depends on AURORA_STATE_MACHINE_AUDIT
	help
	  Maximum number of files in the directory where the audit writes
	  output files.
	  If the maximum is reached, old files are overwritten.

config AURORA_STATE_MACHINE_SHELL
	bool "State machine shell commands"
	depends on SHELL
	help
	  Enable shell commands for inspecting state machine type,
	  current state, forcing transitions, viewing the audit log and
	  editing the flight thresholds.

config AURORA_STATE_MACHINE_CONFIG_STORE
	bool "Persist flight thresholds in flash"
	depends on FLASH
	select CRC
	default y
	help
	  Keep the flight thresholds in the flash partition selected by the
	  'auxspace,sm-config' chosen node, so a set made over the shell
	  survives a reboot.  The partition must be exactly one erase page.
	  Without the chosen node the thresholds stay at their Kconfig
	  values and saving reports -ENOTSUP.

menu "Flight thresholds (defaults)"

comment "Factory defaults - the running values can be changed at"
comment "runtime and are persisted, see the state_machine shell."

config BOOST_ACCELERATION
	int "Boost detection acceleration threshold"
	default 30
	help
		Acceleration threshold in m/s^2 for boost detection.

config BOOST_ALTITUDE
	int "Boost detection altitude threshold"
	default 50
	help
		Altitude threshold in meters for boost detection.

config BURNOUT_ACCELERATION
	int "Burnout detection acceleration threshold"
	default 15
	help
		Acceleration threshold in m/s^2 for burnout detection.

config MAIN_DESCENT_HEIGHT
	int "Main PYRO event height threshold"
	default 200
	help
		Descent height threshold in meters for MAIN Pyro event.

config LANDING_VELOCITY
	int "Velocity threshold for landing detection"
	default 2
	help
		Velocity threshold in m/s for landing detection.

config ARM_ANGLE
	int "Angle threshold for arming"
	default 85
	help
		Angle threshold in degrees for arming the system.
		0 degrees is horizontal, 90 degrees is vertical.

config DISARM_ANGLE
	int "Angle threshold for disarming"
	default 30
	help
		Angle threshold in degrees for disarming the system.
		0 degrees is horizontal, 90 degrees is vertical.

config DISARM_ANGLE_SAMPLES
	int "Number of disarm angle samples"
	default 10
	range 1 1000
	help
		Number of consecutive samples with angle < DISARM_ANGLE to
		disarm.

config BOOST_TIMER_MS
	int "Boost timer duration"
	default 900
	help
		Boost timer duration in milliseconds.
		Both BOOST_ACCELERATION and BOOST_ALTITUDE must be reached and held
		asserted during this time.

config LANDING_TIMER_MS
	int "Landing timer duration"
	default 500
	help
		Landing timer duration in milliseconds.
		LANDING_VELOCITY must be reached and held asserted during this time.

config APOGEE_TIMEOUT_MS
	int "Apogee timeout duration"
	default 60000
	help
		Time after which the APOGEE state returns to IDLE in milliseconds,
		if no further state changes occur.

config MAIN_TIMEOUT_MS
	int "Main to REDUNDANT duration"
	default 2000
	help
		Time after which the redundand pyro channel is fired after MAIN in
		milliseconds.

config REDUNDANT_TIMEOUT_MS
	int "Redundant timeout duration"
	default 900000
	help
		Time after which the REDUNDANT state returns to IDLE in milliseconds,
		if no further state changes occur.

endmenu

endif
