config AURORA_STATE_MACHINE
	bool "Support for state machine"
	help
		This option enables functionality for the aurora state machine
		lib.

if AURORA_STATE_MACHINE

module = STATE_MACHINE
module-str = STATE_MACHINE
source "subsys/logging/Kconfig.template.log_config"

choice AURORA_STATE_MACHINE_TYPE
	bool "State Machine Type"
	depends on AURORA_STATE_MACHINE
	default SIMPLE_STATE

config SIMPLE_STATE
	bool "Simple State machine"
	help
		Simple State machine with apogee detection, single pyro ignition
		and basic safety features.
		Ideal for small form factor boards and rockets.

endchoice

config AURORA_STATE_MACHINE_RBF
	bool "Remove-before-flight arm input"
	depends on GPIO
	help
	  Take the arm signal from the mechanical safety interlock -
	  streamer, key or shorting plug - on the GPIO selected by the
	  auxspace,rbf dt chosen node, instead of from the application.
	  The line is asserted while the interlock is installed (safe); the
	  vehicle counts as armed once it is pulled.  When enabled, the pin
	  overrides sm_inputs.armed on every update.

config AURORA_STATE_MACHINE_RBF_DEBOUNCE_MS
	int "RBF input debounce window (ms)"
	default 50
	range 0 5000
	depends on AURORA_STATE_MACHINE_RBF
	help
	  Time the RBF contact has to stay quiet before a change is taken as
	  real.  Every edge restarts the window, so a chattering plug cannot
	  arm and disarm the machine repeatedly.

config AURORA_STATE_MACHINE_AUDIT
	bool "State machine audit log"
	default y if AURORA_STATE_MACHINE && CONFIG_FILE_SYSTEM
	help
	  Enable a ring-buffer audit log that records timestamped state
	  transitions and notable events.  Useful for post-flight analysis
	  and shell diagnostics.

config AURORA_STATE_MACHINE_AUDIT_LOG_SIZE
	int "Maximum number of audit log entries"
	default 32
	depends on AURORA_STATE_MACHINE_AUDIT
	help
	  Size of the ring buffer used for the audit log.  Oldest entries
	  are silently overwritten when full.

config AURORA_STATE_MACHINE_AUDIT_BASE_PATH
	string "Output directory for state machine audit files"
	default "/state"
	depends on AURORA_STATE_MACHINE_AUDIT
	help
	  Directory where the state machine audit writes output files.
	  The final path is <base_path>/audit.<index>.

config AURORA_STATE_MACHINE_AUDIT_MAX_FILES
	int "Maximum number of files in AURORA_STATE_MACHINE_AUDIT_BASE_PATH"
	default 200
	depends on AURORA_STATE_MACHINE_AUDIT
	help
	  Maximum number of files in the directory where the audit writes
	  output files.
	  If the maximum is reached, old files are overwritten.

config AURORA_STATE_MACHINE_SHELL
	bool "State machine shell commands"
	depends on SHELL
	help
	  Enable shell commands for inspecting state machine type,
	  current state, forcing transitions, and viewing the audit log.

endif
