 *
 * AUX-Core-6501 hardware:
 *   - ESP32-S3-WROOM-1 (U4)
 *   - Native SDHC micro-SD slot (J6), 4-bit, no separate card-detect line
 *   - ST LSM6DSO32 6-DoF IMU (U5) at 0x6a, INT1 on GPIO21
 *   - ST LSM6DSV320X high-g IMU (U1) at 0x6b, INT1 on GPIO10
 *   - TE MS5607-02BA barometer (U6) at 0x77, no interrupt line
 *   - ST LIS3MDL magnetometer (U7) at 0x1c, DRDY on GPIO48
 *   - TI TCAN334 CAN transceiver (U3) with STB and SHDN under GPIO control
 *   - Two AUX-Stack data connectors (J1 top, J2 bottom)
 *   - Green STATE LED (D4) and SD LED (D5); D3 is a hard-wired power LED
 *   - Buzzer (BZ1) driven through the Q1 FET
 *   - USB-C (J7) with a CH224A PD sink, native USB-Serial/JTAG console
 *
 * There is no remove-before-flight input on rev 01 and none is needed: the
 * AUX-Pwr board is the interlock, and only powers the Core board when the
 * vehicle should be armed. ARM and LIFTOFF are outputs towards the stack.
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/input/esp32-touch-sensor-input.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/sensor/lsm6dso.h>
#include <zephyr/dt-bindings/sensor/lsm6dsvxxx.h>
#include <zephyr/dt-bindings/sensor/lsm6dsv320x.h>
#include <auxspace/dt-bindings/gpio/auxspaceev-aux-stack-data-connector.h>

/ {

	model = "Auxspace e.V. AUX-Core-65-01";
	compatible = "espressif,esp32s3";

	aliases {
		i2c-0 = &i2c0;
		i2c-1 = &i2c1;
		watchdog0 = &wdt0;
		uart-0 = &uart0;
		sw0 = &button0;
	};

	chosen {
		zephyr,sram = &sram1;
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,bt-hci = &esp32_bt_hci;
	};

	buttons: buttons {
	compatible = "gpio-keys";

		/* SW3 shorts GPIO0 to GND through R23. */
		button0: button_0 {
			gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "BOOT Button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	/* BZ1 sits between +3V3 and the drain of Q1, so a high on GPIO45
	 * sounds the buzzer.
	 */
	buzzer0: buzzer_0 {
		compatible = "pwm-buzzer";
		/* Default tone for buzzer_beep(); tones set their own period. */
		pwms = <&ledc0 0 PWM_HZ(4000) PWM_POLARITY_NORMAL>;
		status = "disabled";
	};

	pwmleds: pwmleds {
		compatible = "pwm-leds";
		status = "disabled";

		state_pwm_led: led_pwm_0 {
			pwms = <&ledc0 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
			label = "STATE Notifier LED";
		};
	};

	status_leds: status-leds {
		compatible = "gpio-leds";

		/* SD LED; active high. */
		sd_activity_led: led_sd {
			gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;
			label = "SD Activity LED";
		};
	};

	/* J1 and J2 are wired in parallel for the information signals, so both
	 * connectors map onto the same MCU pins.
	 */
	top_data_connector: connector_0 {
		compatible = "auxspaceev,aux-stack-data-connector";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <AUX_DATA_ARM 0 &gpio0 15 0>,
			   <AUX_DATA_LIFTOFF 0 &gpio1 14 0>,
			   <AUX_DATA_PWRFLT 0 &gpio1 7 0>;

		can-bus = <&twai>;
		i2c-bus = <&i2c1>;
		uart-bus = <&uart1>;
	};

	bottom_data_connector: connector_1 {
		compatible = "auxspaceev,aux-stack-data-connector";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <AUX_DATA_ARM 0 &gpio0 15 0>,
			   <AUX_DATA_LIFTOFF 0 &gpio1 14 0>,
			   <AUX_DATA_PWRFLT 0 &gpio1 7 0>;

		can-bus = <&twai>;
		i2c-bus = <&i2c1>;
		uart-bus = <&uart2>;
	};

	/* Signals this board drives onto the stack. ARM and LIFTOFF report
	 * this board's own state outwards; neither is ever read back as an
	 * input
	 */
	status_signals: status-signals {
		compatible = "gpio-leds";

		arm_status: arm0 {
			gpios = <&top_data_connector AUX_DATA_ARM GPIO_ACTIVE_HIGH>;
			label = "ARM Status";
		};

		liftoff_status: liftoff0 {
			gpios = <&top_data_connector AUX_DATA_LIFTOFF GPIO_ACTIVE_HIGH>;
			label = "LIFTOFF Status";
		};

		pwrflt_status: pwrflt0 {
			gpios = <&top_data_connector AUX_DATA_PWRFLT GPIO_ACTIVE_LOW>;
			label = "PWRFLT Status";
		};
	};

	/* U3 TCAN334: SHDN (GPIO17) high shuts the transceiver down, STB
	 * (GPIO16) high puts it in standby. Both have to be driven low for
	 * normal operation, and neither has an external pull.
	 */
	can_phy0: can-phy0 {
		compatible = "ti,tcan334", "can-transceiver-gpio";
		enable-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
		standby-gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
		max-bitrate = <5000000>;
		#phy-cells = <0>;
	};

};

&pinctrl {
	/* J6 micro-SD slot. CD and DAT3 is shared, so there is no CD here. */
	sdmmc_default: sdmmc_default {
		group1 {
			pinmux = <SDHC0_CLKOUT_GPIO6>,
				 <SDHC0_CMD_GPIO40>,
				 <SDHC0_DATA0_GPIO5>,
				 <SDHC0_DATA1_GPIO4>,
				 <SDHC0_DATA2_GPIO42>,
				 <SDHC0_DATA3_GPIO41>;
			bias-pull-up;
		};
	};

	twai_default: twai_default {
		group1 {
			pinmux = <TWAI_TX_GPIO18>,
				 <TWAI_RX_GPIO8>;
		};
	};
};

&uart0 {
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

aux_data_uart_top: &uart1 {
	current-speed = <115200>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
};

aux_data_uart_bottom: &uart2 {
	current-speed = <115200>;
	pinctrl-0 = <&uart2_default>;
	pinctrl-names = "default";
};

&touch {
	debounce-interval-ms = <30>;
	href-microvolt = <2700000>;
	lref-microvolt = <500000>;
	href-atten-microvolt = <1000000>;
	filter-mode = <ESP32_TOUCH_FILTER_MODE_IIR_16>;
	filter-debounce-cnt = <1>;
	filter-noise-thr = <ESP32_TOUCH_FILTER_NOISE_THR_4_8TH>;
	filter-jitter-step = <4>;
	filter-smooth-level = <ESP32_TOUCH_FILTER_SMOOTH_MODE_IIR_2>;
};

&i2c0 {
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";

	/* U5, IMU. */
	lsm6dso320: lsm6dso32@6a {
		compatible = "st,lsm6dso32";
		reg = <0x6a>;
		irq-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
		int-pin = <1>;
		status = "disabled";
	};

	/* U1, High-G Accel. Reaching the 32g..320g ranges needs
	 * accel-hg-odr to turn the high-g sensor on; left to the application.
	 */
	lsm6dsv320x0: lsm6dsv320x@6b {
		compatible = "st,lsm6dsv320x";
		reg = <0x6b>;
		int1-gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
		drdy-pin = <1>;
		status = "disabled";
	};

	/* U7, Magnetometer. Only DRDY is wired; INT is unconnected since it is
	 * not supported by the driver anyways. Also there is pin shortage */
	lis3mdl0: lis3mdl@1c {
		compatible = "st,lis3mdl-magn";
		reg = <0x1c>;
		irq-gpios = <&gpio1 16 GPIO_ACTIVE_HIGH>;
		status = "disabled";
	};

	/* U6, Baro.
	 * The MS5607 has no interrupt output, so it has to be polled.
	 */
	ms5607_0: ms5607@77 {
		compatible = "meas,ms5607";
		reg = <0x77>;
		status = "disabled";
	};
};

aux_data_i2c: &i2c1 {
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
};

aux_data_can: &twai {
	pinctrl-0 = <&twai_default>;
	pinctrl-names = "default";
	phys = <&can_phy0>;
};

&ledc0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&ledc0_default>;
	pinctrl-names = "default";

	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};

	channel1@1 {
		reg = <0x1>;
		timer = <1>;
	};
};

&wifi {
	status = "okay";
};

&wdt0 {
	status = "okay";
};


&sdhc0 {
	bus-width = <4>;
	pinctrl-0 = <&sdmmc_default>;
	pinctrl-names = "default";
	max-bus-freq = <40000000>;
	status = "disabled";

	mmc0: mmc_0 {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "MMC";
		status = "disabled";
	};
};

&usb_serial {
	status = "okay";
};
