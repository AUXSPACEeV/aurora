 *
 * AUX-Stack-Core hardware:
 *   - Native SDHC SD card (espressif,esp32-sdhc slot, 4-bit) instead of the
 *     rev.1 SPI-attached card.
 *   - Updated barometer to the Bosch BMP581.
 *   - Separate Remove Before Flight Pin.
 *   - Extra Status LEDs
 *   - USB-C
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/input/esp32-touch-sensor-input.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/sensor/lsm6dso.h>
#include <zephyr/dt-bindings/sensor/adxl367.h>
#include <auxspace/dt-bindings/gpio/auxspaceev-aux-stack-data-connector.h>

/ {

	model = "Auxspace e.V. AUX-Core-65-01";
	compatible = "espressif,esp32s3";

	aliases {
		i2c-0 = &i2c0;
		i2c-1 = &i2c1;
		watchdog0 = &wdt0;
		uart-0 = &uart0;
		sw0 = &button0;
	};

	chosen {
		zephyr,sram = &sram1;
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,bt-hci = &esp32_bt_hci;
	};

	buttons: buttons {
	compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "BOOT Button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	buzzer0: buzzer_0 {
		compatible = "auxspaceev,pwm-buzzer";
		pwms = <&ledc0 0 PWM_MSEC(200) PWM_POLARITY_NORMAL>;
		status = "disabled";
	};

	pwmleds: pwmleds {
		compatible = "pwm-leds";
		status = "disabled";

		red_pwm_led: led_pwm_0 {
			pwms = <&ledc0 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
			label = "RED Notifier LED";
		};
	};

	status_leds: status-leds {
		compatible = "gpio-leds";

		sd_activity_led: led_sd {
			gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
			label = "SD Activity LED";
		};
	};

	top_data_connector: connector_0 {
		compatible = "auxspaceev,aux-stack-data-connector";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <AUX_DATA_ARM 0 &gpio0 15 0>,
			   <AUX_DATA_LIFTOFF 0 &gpio0 23 0>,
			   <AUX_DATA_PWRFLT 0 &gpio1 6 0>;

		can-bus = <&twai>;
		i2c-bus = <&i2c1>;
		uart-bus = <&uart1>;
	};

	bottom_data_connector: connector_1 {
		compatible = "auxspaceev,aux-stack-data-connector";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <AUX_DATA_ARM 0 &gpio0 15 0>,
			   <AUX_DATA_LIFTOFF 0 &gpio0 23 0>,
			   <AUX_DATA_PWRFLT 0 &gpio1 6 0>;

		can-bus = <&twai>;
		i2c-bus = <&i2c1>;
		uart-bus = <&uart2>;
	};

	status_signals: status-signals {
		compatible = "gpio-leds";

		arm_status: arm0 {
			gpios = <&top_data_connector AUX_DATA_ARM GPIO_ACTIVE_HIGH>;
			label = "ARM Status";
		};

		liftoff_status: liftoff0 {
			gpios = <&top_data_connector AUX_DATA_LIFTOFF GPIO_ACTIVE_HIGH>;
			label = "LIFTOFF Status";
		};

		pwrflt_status: pwrflt0 {
			gpios = <&top_data_connector AUX_DATA_PWRFLT GPIO_ACTIVE_HIGH>;
			label = "PWRFLT Status";
		};
	};

};

&pinctrl {
	sdmmc_default: sdmmc_default {
		group1 {
			pinmux = <SDHC0_CLKOUT_GPIO6>,
				 <SDHC0_CMD_GPIO39>,
				 <SDHC0_DATA0_GPIO5>,
				 <SDHC0_DATA1_GPIO4>,
				 <SDHC0_DATA2_GPIO42>,
				 <SDHC0_DATA3_GPIO41>;
			bias-pull-up;
		};
	};

	twai_default: twai_default {
		group1 {
			pinmux = <TWAI_RX_GPIO18>,
				 <TWAI_TX_GPIO8>;
		};
	};
};

&uart0 {
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

aux_data_uart_top: &uart1 {
	current-speed = <115200>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
};

aux_data_uart_bottom: &uart2 {
	current-speed = <115200>;
	pinctrl-0 = <&uart2_default>;
	pinctrl-names = "default";
};

&touch {
	debounce-interval-ms = <30>;
	href-microvolt = <2700000>;
	lref-microvolt = <500000>;
	href-atten-microvolt = <1000000>;
	filter-mode = <ESP32_TOUCH_FILTER_MODE_IIR_16>;
	filter-debounce-cnt = <1>;
	filter-noise-thr = <ESP32_TOUCH_FILTER_NOISE_THR_4_8TH>;
	filter-jitter-step = <4>;
	filter-smooth-level = <ESP32_TOUCH_FILTER_SMOOTH_MODE_IIR_2>;
};

&i2c0 {
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";

	lsm6dso320: lsm6dso32@6b {
		compatible = "st,lsm6dso32";
		reg = <0x6b>;
		irq-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
		int-pin = <1>;
		status = "disabled";
	};

	dps310_0: dps310@76 {
		compatible = "infineon,dps310";
		// TODO: Check for Interrupt support
		reg = <0x76>;
		status = "disabled";
	};

	adxl367_0: adxl367@1d{
		compatible = "adi,adxl367";
		reg = <0x1d>;
		int1-gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
		status = "disabled";
	};

	// TODO: Check if this supports the MLX90395
	mlx90394_0: mlx90394@0c {
		compatible = "melexis,mlx90394";
		// TODO: Check for Interrupt support
		reg = <0x0c>;
		status = "disabled";
	};


};

aux_data_i2c: &i2c1 {
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
};

&i2s0 {
	pinctrl-0 = <&i2s0_default>;
	pinctrl-names = "default";
};

&i2s1 {
	pinctrl-0 = <&i2s1_default>;
	pinctrl-names = "default";
};

aux_data_can: &twai {
	pinctrl-0 = <&twai_default>;
	pinctrl-names = "default";
};

&ledc0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&ledc0_default>;
	pinctrl-names = "default";

	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};

	channel1@1 {
		reg = <0x1>;
		timer = <1>;
	};
};

&wifi {
	status = "okay";
};

&wdt0 {
	status = "okay";
};


&sdhc0 {
	bus-width = <4>;
	pinctrl-0 = <&sdmmc_default>;
	pinctrl-names = "default";
	max-bus-freq = <40000000>;
	status = "disabled";

	mmc0: mmc_0 {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "MMC";
		status = "disabled";
	};
};

&usb_serial {
	status = "okay";
};
