 *
 * AUX-Tel-65-01 hardware: the telemetry board of the AUX-Stack. A 65 mm
 * round PCB, revision 01, that stacks on AUX-Core-65-01 through the same
 * pair of AUX-Stack connectors.
 *
 *   - Würth Daphnis-I (STM32WLE5CCU6) LoRa module. The antenna goes to
 *     the module's UMRF (U.FL / MHF1) connector, so the RF pad is left
 *     as an unconnected solder pad - which is what the user manual
 *     requires when the UMRF connector is used, not an omission.
 *   - MCP2515 SPI CAN controller behind a TCAN334 transceiver, tapped off
 *     the stack CAN_H/CAN_L pair (124 Ohm split termination on board).
 *   - Inter-board link to AUX-Core over the stack UART on LPUART1.
 *   - Console and SWD on the J5 2x3 debug header.
 *   - Two green status LEDs, RESET and BOOT buttons.
 *   - 3V3 from a TPS7B8601 LDO fed by a jumper-selected VBus rail.
 *
 * ---------------------------------------------------------------------
 * Hardware revision this file describes
 * ---------------------------------------------------------------------
 * Two rev-01 netlist changes are assumed here, because the MCP2515
 * cannot be driven at all without them:
 *
 *   1. SPI_SCK moves from Daphnis pin 2 (PB8) to pin 16 (PA5), and ARM
 *      takes pin 2 in exchange. PB8 has no SPI alternate function on the
 *      STM32WLE5, while PA5 is SPI1_SCK. The module's other two SPI1_SCK
 *      pads, PA1 (B2) and PB3 (31), would work under our own firmware
 *      too - "RESERVED" only means the factory AT firmware claims them
 *      (see daphnis1.dtsi) - but rev 01 leaves both unrouted, so
 *      swapping two nets that are already routed is the cheaper fix.
 *   2. The MCP2515 ~INT (U4 pin 12) is routed to Daphnis pin 13
 *      (PA0, /WAKE_UP), which rev 01 leaves as a no-connect. Zephyr's
 *      microchip,mcp2515 binding has int-gpios as a required property,
 *      and the controller is unusable without an interrupt line. PA0 is
 *      also the module's wake-capable input, which is what a CAN
 *      interrupt wants to be.
 *
 * Still open on the PCB and NOT worked around here:
 *   - MCP2515 ~RESET (U4 pin 17) is a no-connect, i.e. floating. A
 *     pull-up to +3V3 is enough; one of the unrouted pads above (PA15 on
 *     pin 28, say) would give firmware control over it instead.
 *   - TCAN334 STB and SHDN (U3 pins 8 and 5) are no-connects. Tie them
 *     low for normal mode rather than relying on internal biasing.
 *   - D1, D2 and D3 are drawn anode-to-GND, cathode-to-driver, which on
 *     paper is backwards: the module's LED_1/LED_2 are active HIGH (user
 *     manual chapter 5.9), so the GPIO is meant to source into the anode.
 *     The assembled rev-01 board does light D3 in bootloader mode, so the
 *     physical polarity is right and only the schematic symbols are
 *     inverted - worth fixing before the next assembly run, since the
 *     discrepancy could be resolved the other way next time. The LED
 *     nodes below are GPIO_ACTIVE_HIGH per the user manual; if a blink
 *     test comes out inverted, flip them to GPIO_ACTIVE_LOW.
 */

#include <auxspace/dt-bindings/gpio/auxspaceev-aux-stack-data-connector.h>

/ {
	model = "Auxspace e.V. AUX-Tel-65-01";
	compatible = "auxspaceev,tel65";

	aliases {
		watchdog0 = &iwdg;
		lora0 = &lora;
		led0 = &led_1;
		led1 = &led_2;
		uart-0 = &usart1;
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		/* J5 debug header; the stack UART stays free for AUX-Core. */
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,system-timer = &lptim1;
		zephyr,canbus = &aux_data_can;
	};

	status_leds: status-leds {
		compatible = "gpio-leds";

		led_1: led_1 {
			gpios = <&gpioa 7 GPIO_ACTIVE_HIGH>;
			label = "LED_1 (green)";
		};

		led_2: led_2 {
			gpios = <&gpioa 4 GPIO_ACTIVE_HIGH>;
			label = "LED_2 (green)";
		};
	};

	/*
	 * Both stack connectors are wired in parallel on AUX-Tel: the four
	 * information signals land on the same module pins, and CAN_H/CAN_L
	 * plus the UART and I2C pairs are bridged top-to-bottom through 0R
	 * links (R21..R26). The board is a pass-through for I2C, so neither
	 * connector claims an i2c-bus - nothing on AUX-Tel sits on it.
	 */
	top_data_connector: connector_0 {
		compatible = "auxspaceev,aux-stack-data-connector";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <AUX_DATA_ARM 0 &gpiob 8 0>,
			   <AUX_DATA_LIFTOFF 0 &gpiob 7 0>,
			   <AUX_DATA_PWRFLT 0 &gpiob 6 0>,
			   <AUX_DATA_BAT_ON 0 &gpioa 8 0>;

		can-bus = <&aux_data_can>;
		uart-bus = <&lpuart1>;
	};

	bottom_data_connector: connector_1 {
		compatible = "auxspaceev,aux-stack-data-connector";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <AUX_DATA_ARM 0 &gpiob 8 0>,
			   <AUX_DATA_LIFTOFF 0 &gpiob 7 0>,
			   <AUX_DATA_PWRFLT 0 &gpiob 6 0>,
			   <AUX_DATA_BAT_ON 0 &gpioa 8 0>;

		can-bus = <&aux_data_can>;
		uart-bus = <&lpuart1>;
	};

	/*
	 * ARM, LIFTOFF and PWRFLT are inputs on AUX-Tel - AUX-Core and
	 * AUX-Pwr drive them - so they are reached through the connector
	 * nexus above. BAT_ON is the one signal this board drives.
	 */
	stack_outputs: stack-outputs {
		compatible = "gpio-leds";

		bat_on_request: bat_on0 {
			gpios = <&top_data_connector AUX_DATA_BAT_ON GPIO_ACTIVE_HIGH>;
			label = "BAT_ON Request";
		};
	};
};

/* HSI16 x 6 / 2 = 48 MHz. HSE is reserved for the radio's TCXO. */
&pll {
	div-m = <1>;
	mul-n = <6>;
	div-r = <2>;
	div-q = <2>;
	clocks = <&clk_hsi>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(48)>;
	cpu1-prescaler = <1>;
	ahb3-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
};

/*
 * LPTIM1 off the LSE is wired up as zephyr,system-timer, but
 * CONFIG_STM32_LPTIM_TIMER also depends on CONFIG_PM, so the kernel runs
 * on SysTick until an application opts into power management. Enabling
 * CONFIG_PM=y is all it takes to move the tick over.
 */
&lptim1 {
	clocks = <&rcc STM32_CLOCK(APB1, 31)>,
		 <&rcc STM32_SRC_LSE LPTIM1_SEL(3)>;
	status = "okay";
};

&rtc {
	clocks = <&rcc STM32_CLOCK(APB1, 10)>,
		 <&rcc STM32_SRC_LSE RTC_SEL(1)>;
	status = "okay";
};

&iwdg {
	status = "okay";
};

&aes {
	status = "okay";
};

&rng {
	status = "okay";
};

/* J5 pin 3 (UTXD1) / pin 1 (URXD1), alongside SWDIO and SWDCLK. */
&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/*
 * The stack UART. Daphnis LPUTXD1 (PA2) drives the connector's UART_RX
 * pin and LPURXD1 (PA3) listens on UART_TX, i.e. the connector pins are
 * named from the brain board's point of view, so this mates with
 * AUX-Core's aux_data_uart_* without a crossover.
 */
aux_data_uart: &lpuart1 {
	pinctrl-0 = <&lpuart1_tx_pa2 &lpuart1_rx_pa3>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&spi1 {
	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pa12>;
	pinctrl-names = "default";
	cs-gpios = <&gpiob 2 GPIO_ACTIVE_LOW>;

	/*
	 * Y2 is an 8 MHz crystal, which caps the MCP2515 at 500 kbit/s
	 * (Tq = 2 x (BRP + 1) / Fosc, and a bit needs at least 8 Tq). No
	 * bitrate is set here so both ends of the stack bus fall back to
	 * CONFIG_CAN_DEFAULT_BITRATE, the same as AUX-Core's TWAI.
	 */
	aux_data_can: can@0 {
		compatible = "microchip,mcp2515";
		reg = <0x0>;
		spi-max-frequency = <DT_FREQ_M(4)>;
		osc-freq = <DT_FREQ_M(8)>;
		int-gpios = <&gpioa 0 GPIO_ACTIVE_LOW>;
		status = "disabled";

		can-transceiver {
			max-bitrate = <1000000>;
		};
	};
};

/*
 * No MCUboot on this board: the only programming path is SWD on J5, and
 * 256 kB of flash does not leave room for two image slots plus a
 * bootloader. The application therefore starts at the bottom of flash.
 */
&flash0 {
	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		slot0_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00000000 DT_SIZE_K(248)>;
		};

		storage_partition: partition@3e000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x0003e000 DT_SIZE_K(8)>;
		};
	};
};
