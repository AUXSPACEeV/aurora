# This file is the application Kconfig entry point. All application Kconfig
# options can be defined here or included via other application Kconfig files.
# You can browse these options using the west targets menuconfig (terminal) or
# guiconfig (GUI).

menu "Zephyr"

source "Kconfig.zephyr"

endmenu

module = FLIGHT_COMPUTER
module-str = FLIGHT_COMPUTER
source "subsys/logging/Kconfig.template.log_config"

config AURORA_FAKE_SENSORS
	bool "Synthetic IMU/baro data source (no hardware)"
	depends on AURORA_SENSORS
	help
	  Replaces the hardware IMU and barometer polling threads with a
	  synthetic flight-profile generator. The generator publishes
	  imu_data/baro_data messages on the same zbus channels, at the
	  same cadence and thread priorities, so the downstream data path,
	  Kalman filter and state machine can be exercised without real
	  sensors. Works on native_sim and on real hardware targets — use
	  the `sim` snippet (`west build -S sim ...`) to layer this on top
	  of any board. A shell command "sim launch" kicks off the canned
	  ascent/descent profile.

config AURORA_FAKE_SENSORS_REPLAY
	bool "Replay recorded flight log instead of the algorithmic profile"
	depends on IMU && BARO
	select AURORA_FAKE_SENSORS
	help
	  Swap the analytic flight-profile generator (fake_sensors.c) for
	  a playback engine (fake_sensors_replay.c) that streams samples
	  embedded at build time from a recorded flights.csv. Pre-launch
	  the threads hold the rocket stationary by republishing the first
	  recorded sample, so attitude calibration converges as usual; the
	  `sim launch` shell command (or the AURORA_SIM_AUTOTEST autolaunch
	  task) then starts replaying the recording at its original
	  cadence. Implies AURORA_FAKE_SENSORS.

config AURORA_FAKE_SENSORS_SYNTH
	def_bool AURORA_FAKE_SENSORS && !AURORA_FAKE_SENSORS_REPLAY
	help
	  Internal switch: true when AURORA_FAKE_SENSORS is enabled but
	  the replay backend is not, i.e. the algorithmic profile in
	  fake_sensors.c should be compiled in.

config AURORA_FAKE_SENSORS_REPLAY_INPUT
	string "Path to flights.csv used by the replay backend"
	depends on AURORA_FAKE_SENSORS_REPLAY
	default "flight_logs/multimeter/2026-05-03/flight1/flights.csv"
	help
	  Path (relative to the aurora module root, i.e. the directory that
	  contains zephyr/module.yml) to the flights.csv file embedded by
	  the replay generator. May be overridden in prj.conf or via
	  -DCONFIG_AURORA_FAKE_SENSORS_REPLAY_INPUT=... to swap recordings.

config AURORA_SIM_AUTOTEST
	bool "Automated simulation test (CI mode)"
	depends on IMU && BARO
	select AURORA_FAKE_SENSORS
	select ASSERT
	help
	  Enables the full automated flight simulation for CI. Pulls in fake
	  sensors and assertion support, then starts a thread that waits for
	  altitude calibration, and auto-launches the flight
	  profile. Exits with code 0 on SM_LANDED, code 1 on SM_ERROR or after
	  AURORA_SIM_AUTOLAUNCH_TIMEOUT_MS. Run ./zephyr.exe and check the process exit code.

config AURORA_SIM_AUTOLAUNCH_TIMEOUT_MS
	int "Autolaunch watchdog timeout (ms)"
	depends on AURORA_SIM_AUTOTEST
	default 120000
	help
	  Maximum time in milliseconds the autolaunch thread waits for SM_LANDED
	  after triggering the flight profile. Exits with code 1 if this
	  deadline is exceeded.
